# === Application ===
APP_ENV=local

# === Database (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finsight
DB_USERNAME=finsight
DB_PASSWORD=

# === JWT ===
JWT_SECRET=
# Optional. Put a private password in .env.local to enable the local demo login.
DEMO_PASSWORD=
DEMO_LOGIN_ENABLED=false
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === AI Providers (configure at least one) ===
# Export these two values in the backend process environment to enable Copilot.
COPILOT_PROVIDER=openai
COPILOT_GROQ_API_KEY=
COPILOT_GROQ_MODEL=qwen/qwen3.8-27b
COPILOT_OPENAI_API_KEY=
COPILOT_OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# === AI Configuration ===
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_TOKENS_PER_WORKFLOW=4000
AI_MAX_COST_USD_PER_WORKFLOW=0.10

# === Object Storage (optional local S3Mock) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_IMPORTS=finsight-imports

# === Email (Mailpit locally) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@finsight.local

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
